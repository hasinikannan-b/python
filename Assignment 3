import random
import time

TITLES = {"dr", "mr", "mrs", "ms", "prof", "shri", "smt"}


def normalise_number(text):
    digits = "".join(ch for ch in text if ch.isdigit())
    if len(digits) >= 10:
        return digits[-10:]  # Drop a country code or leading zero.
    return ""  # Too short to be used as a key.


def normalise_name(text):
    text = "".join(ch if ch.isalpha() or ch == " " else " " for ch in text.lower())
    return " ".join(word for word in text.split() if word not in TITLES)


def normalise_email(text):
    return text.strip().lower()


def names_match(name, known_names):
    # Treat names as matching when one set of name words contains the other.
    if name == "" or not known_names:
        return True
    words = set(name.split())
    for other in known_names:
        other_words = set(other.split())
        if words <= other_words or other_words <= words:
            return True
    return False


def merge_contacts(contacts):
    groups = []  # Each group has sets of names, numbers, and emails.
    by_number = {}  # A shared number can belong to multiple groups.
    by_email = {}  # Normalised email -> group id.

    for contact in contacts:
        name = normalise_name(contact["name"])
        numbers = {normalise_number(phone) for phone in contact["phones"]} - {""}
        emails = {normalise_email(email) for email in contact["emails"]} - {""}
        found = []

        for number in numbers:
            for group_id in by_number.get(number, []):
                if names_match(name, groups[group_id]["names"]):
                    if group_id not in found:
                        found.append(group_id)
                    break

        for email in emails:
            group_id = by_email.get(email)
            if group_id is not None and group_id not in found:
                found.append(group_id)

        if not found:
            groups.append({"names": set(), "numbers": set(), "emails": set()})
            target = len(groups) - 1
        else:
            target = found[0]
            # This contact connects groups that were previously separate.
            for other in found[1:]:
                for key in ("names", "numbers", "emails"):
                    groups[target][key] |= groups[other][key]
                    groups[other][key] = set()

                for number in groups[target]["numbers"]:
                    ids = [target if group_id == other else group_id
                           for group_id in by_number[number]]
                    by_number[number] = list(dict.fromkeys(ids))
                for email in groups[target]["emails"]:
                    by_email[email] = target

        if name:
            groups[target]["names"].add(name)
        groups[target]["numbers"] |= numbers
        groups[target]["emails"] |= emails

        for number in numbers:
            ids = by_number.setdefault(number, [])
            if target not in ids:
                ids.append(target)
        for email in emails:
            by_email[email] = target

    return [group for group in groups
            if group["names"] or group["numbers"] or group["emails"]]


