# ---------- big test data ----------
def make_words(first_letters, vowels, last_letters):
    return [a + b + c for a in first_letters for b in vowels for c in last_letters]


FIRST = make_words("bcdfghjklm", "aeiou", "nrst")  # 200 different first names.
LAST = make_words("pqrstvwyz", "aeiou", "lmn")[:100]  # 100 different surnames.


def person_contact(person, rng):
    name = person["first"] + " " + person["last"]
    shown = rng.choice([name, name.upper() + ".", "Dr. " + name, person["first"]])
    phones = []
    for digits in person["numbers"]:
        formats = [digits, "+91 " + digits[:5] + " " + digits[5:], "0" + digits,
                   "+91-" + digits, digits[:5] + "-" + digits[5:]]
        phones.append(rng.choice(formats))
    emails = []
    if person["email"] and rng.random() < 0.5:
        emails.append(rng.choice([person["email"], person["email"].upper() + " "]))
    return {"name": shown, "phones": phones, "emails": emails}


def make_data(n):
    rng = random.Random(4)
    m = int(n * 0.6)  # Number of different people.
    people = []
    used = set()

    for i in range(m):
        while True:
            number = str(rng.randint(6000000000, 9999999999))
            if number not in used:
                used.add(number)
                break
        people.append({
            "first": FIRST[i % 200],
            "last": LAST[(i // 200) % 100] + "abc"[i // 20000],
            "numbers": [number],
            "email": "user{}@mail.com".format(i) if i % 3 == 0 else "",
        })

    # Every 50th person shares a landline with the next one.
    for i in range(0, m - 1, 50):
        landline = "44{:08d}".format(i)
        people[i]["numbers"].append(landline)
        people[i + 1]["numbers"].append(landline)
        people[i + 1]["first"] = "z" + people[i + 1]["first"]

    contacts = [person_contact(person, rng) for person in people]
    contacts += [person_contact(rng.choice(people), rng) for _ in range(n - m)]
    rng.shuffle(contacts)
    return contacts, m


def same_person(a, b):
    # The pair-by-pair rule used for the O(n squared) alternative.
    numbers_a = {normalise_number(phone) for phone in a["phones"]} - {""}
    numbers_b = {normalise_number(phone) for phone in b["phones"]} - {""}
    if numbers_a & numbers_b and names_match(
            normalise_name(a["name"]), [normalise_name(b["name"])]) :
        return True

    emails_a = {normalise_email(email) for email in a["emails"]}
    emails_b = {normalise_email(email) for email in b["emails"]}
    return bool(emails_a & emails_b)


def count_by_pairs(contacts):
    labels = list(range(len(contacts)))
    for i in range(len(contacts)):
        for j in range(i):
            if same_person(contacts[i], contacts[j]):
                old, new = labels[i], labels[j]
                if old != new:
                    labels = [new if label == old else label for label in labels]
    return len(set(labels))


