# Task 6 - Stage 5: implement and demonstrate the fest registration package
import os, tempfile, time

def process_fest(in_folder, dept_files, out_folder):
    seen = set()                                  # register numbers already accepted
    master, by_event, errors = [], {}, []
    lines_read = 0
    for dept_file in dept_files:
        path = os.path.join(in_folder, dept_file)
        read_here = 0                             # lines read from this file only
        try:
            for line_no, line in read_lines(path):
                lines_read += 1
                read_here += 1
                try:
                    record = parse_registration(line)
                except BadRecord as e:
                    errors.append((dept_file, line_no, str(e), line))
                    continue
                reg, name, dept, email, events = record
                if reg in seen:
                    errors.append((dept_file, line_no, f"duplicate registration of {reg}", line))
                    continue
                seen.add(reg)
                master.append(record)
                for event in events:
                    by_event.setdefault(event, []).append((reg, name))
        except FileNotFoundError:
            errors.append((dept_file, 0, "department file is missing", ""))
        except UnicodeDecodeError as e:
            errors.append((dept_file, 0,
                           f"file cannot be decoded ({e.reason}); {read_here} line(s) read before the damage", ""))


    os.makedirs(out_folder, exist_ok=True)
    write_master(os.path.join(out_folder, "master_list.csv"), master)
    write_event_lists(os.path.join(out_folder, "events"), by_event)
    write_log(os.path.join(out_folder, "errors.log"), errors)
    summary = {"lines read": lines_read, "accepted": len(master), "rejected": len(errors),
               "events": ", ".join(f"{e}={len(p)}" for e, p in sorted(by_event.items()))}
    write_summary(os.path.join(out_folder, "summary.txt"), summary)
    return master, by_event, errors, summary
