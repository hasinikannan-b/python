# fest/__init__.py

"""College fest registration package."""
# fest/reader.py

def read_lines(path):
    """Yield (line number, text) for every non-blank line of a department file."""
    with open(path, "r", encoding="utf-8") as f:
        for line_no, line in enumerate(f, start=1):
            line = line.strip()
            if line:
                yield line_no, line
# fest/validator.py
class BadRecord(Exception):
    """A registration line that cannot be accepted."""
def valid_email(email):
    """String methods only: one @, text before it, a dot inside the domain."""
    if email == "" or " " in email or email.count("@") != 1:
        return False
    local, domain = email.split("@")
    if local == "" or "." not in domain:
        return False
    if domain.startswith(".") or domain.endswith(".") or ".." in domain:
        return False
    return True
def parse_registration(line):
    """'reg,name,dept,email,event1;event2' -> (reg, name, dept, email, [events])"""
    parts = [p.strip() for p in line.split(",")]
    if len(parts) != 5:
        raise BadRecord(f"expected 5 fields, found {len(parts)}")
    reg, name, dept, email, events = parts
    if not reg.isdigit():
        raise BadRecord(f"register number {reg!r} is not numeric")
    if name == "":
        raise BadRecord("name is empty")
    if not valid_email(email):
        raise BadRecord(f"invalid e-mail {email!r}")
    event_list = [e.strip().title() for e in events.split(";") if e.strip()]
    if not event_list:
        raise BadRecord("no event chosen")
    return reg, name, dept, email.lower(), event_list
# fest/writer.py
import os
def write_master(path, records):
    with open(path, "w", encoding="utf-8") as out:
        for reg, name, dept, email, events in records:
            out.write(f"{reg},{name},{dept},{email},{';'.join(events)}\n")
def write_event_lists(folder, by_event):
    os.makedirs(folder, exist_ok=True)
    for event, people in by_event.items():
        with open(os.path.join(folder, event.replace(" ", "_") + ".txt"), "w", encoding="utf-8") as out:
            for reg, name in people:
                out.write(f"{reg} {name}\n")
def write_log(path, errors):
    with open(path, "w", encoding="utf-8") as out:
        for source, line_no, message, text in errors:
            where = f"{source} line {line_no}" if line_no else source
            out.write(f"{where}: {message}" + (f" -> {text!r}" if text else "") + "\n")
def write_summary(path, summary):
    with open(path, "w", encoding="utf-8") as out:
        for key, value in summary.items():
            out.write(f"{key}: {value}\n")
