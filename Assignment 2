import time
calls = 0
def ways_original(n):
    global calls
    calls += 1
    if n <= 1:
        return 1
    return ways_original(n - 1) + ways_original(n - 2)
additions = 0
def ways_new(n):
    global additions
    a = 1
    b = 1
    for i in range(2, n + 1):
        c = a + b
        additions += 1
        a = b
        b = c
    return b
for n in [10, 20, 25, 30]:
    calls = 0
    start = time.perf_counter()
    r1 = ways_original(n)
    t1 = time.perf_counter() - start
    additions = 0
    start = time.perf_counter()
    r2 = ways_new(n)
    t2 = time.perf_counter() - start
    print(f"n = {n}")
    print(f"   original: answer {r1}, calls {calls}, time {t1:.6f} s")
    print(f"   new     : answer {r2}, additions {additions}, time {t2:.6f} s")
additions = 0
start = time.perf_counter()

r = ways_new(1000)
t = time.perf_counter() - start
print("n = 1000")
print("   original: cannot be run")
print(f"   new     : {len(str(r))} digit answer, additions {additions}, time {t:.6f} s")
