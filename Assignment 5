# Rule-based chatbot backed by a small in-memory database.
import sqlite3

con = sqlite3.connect(":memory:")
con.execute("CREATE TABLE aq (station TEXT, day TEXT, pm25 REAL)")
con.executemany("INSERT INTO aq VALUES (?, ?, ?)", [
    ("Adyar", "2026-10-01", 48.0),
    ("Adyar", "2026-10-04", 60.0),
    ("Guindy", "2026-10-01", 95.0),
    ("Guindy", "2026-10-03", 121.0),
])
KNOWN = {"adyar": "Adyar", "guindy": "Guindy", "manali": "Manali"}


def chatbot(question):
    words = re.findall(r"[a-z0-9.']+", question.lower())
    station = next((KNOWN[word] for word in words if word in KNOWN), None)
    if "pm2.5" in words or "pm25" in words or "air" in words:
        if station is None:
            return "Which station do you mean? I know Adyar, Guindy and Manali."
        row = con.execute(
            "SELECT day, pm25 FROM aq WHERE station = ? ORDER BY day DESC LIMIT 1",
            (station,)).fetchone()
        if row is None:
            return "I have no readings for {} yet.".format(station)
        return "Latest PM2.5 at {}: {} ug/m3 on {}.".format(station, row[1], row[0])
    if "complaint" in words:
        return "To register a complaint, please type it in one message."
    return "Sorry, I did not understand. Ask about the PM2.5 of a station."


print("\nChatbot test")
for question in [
        "What is the PM2.5 in Adyar today?",
        "air quality in Guindy",
        "PM2.5?",
        "How is the PM2.5 in Manali?",
        "Is it safe to take my child out in Adyar?",
        "What was the PM2.5 in Adyar last month?"]:
    print("  Q: {}\n  A: {}".format(question, chatbot(question)))


