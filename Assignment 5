import random
import sqlite3
import time
from datetime import date, timedelta
rng = random.Random(1)
con = sqlite3.connect(":memory:")
con.execute("CREATE TABLE readings (station TEXT, day TEXT, slot INTEGER, pm25 REAL)")
def generate():
    days = [(date(2026, 1, 1) + timedelta(days=d)).isoformat() for d in range(365)]
    for s in range(12):                       # demo scale: present stations, hourly readings
        for d in days:
            for h in range(24):
                yield (f"S{s:03d}", d, h, round(rng.uniform(20, 160), 1))
    for s in range(10):                       # demo scale: new stations, 15-minute readings
        for d in days:
            for q in range(96):
                yield (f"T{s:03d}", d, q, round(rng.uniform(20, 160), 1))
t0 = time.perf_counter()
con.executemany("INSERT INTO readings VALUES (?, ?, ?, ?)", generate())
con.commit()
rows = con.execute("SELECT COUNT(*) FROM readings").fetchone()[0]
print(f"rows in one year at the demo scale: {rows:,}  (load time {time.perf_counter() - t0:.1f} s)")
QUERIES = {
    "Q1 mean of one station in October": ("SELECT AVG(pm25) FROM readings WHERE station = 'T009' "
                                           "AND day BETWEEN '2026-10-01' AND '2026-10-31'"),
    "Q2 worst station-day": ("SELECT station, day, AVG(pm25) AS m FROM readings "
                              "GROUP BY station, day ORDER BY m DESC LIMIT 1"),
        "Q3 days above 60 for one station": ("SELECT COUNT(*) FROM (SELECT day FROM readings WHERE "
                                          "station = 'S007' "
                                          "GROUP BY day HAVING AVG(pm25) > 60)"),
}
def timeit(sql, repeat):
    best = 1e9
    for _ in range(repeat):
        t0 = time.perf_counter()
        con.execute(sql).fetchall()
        best = min(best, time.perf_counter() - t0)
    return best
before = {name: timeit(sql, 1) for name, sql in QUERIES.items()}
print("\nQuery plan of Q1 before the index:")
for row in con.execute("EXPLAIN QUERY PLAN " + QUERIES["Q1 mean of one station in October"]):
    print("  ", row[3])
t0 = time.perf_counter()
con.execute("CREATE INDEX idx_station_day ON readings (station, day)")
t_index = time.perf_counter() - t0
after = {name: timeit(sql, 1) for name, sql in QUERIES.items()}
print("\nQuery plan of Q1 after the index:")
for row in con.execute("EXPLAIN QUERY PLAN " + QUERIES["Q1 mean of one station in October"]):
    print("  ", row[3])
print(f"\nIndex build time: {t_index:.2f} s")
print(f"{'query':<36} {'no index (s)':>13} {'with index (s)':>15} {'speed-up':>9}")
for name in QUERIES:
        print(f"{name:<36} {before[name]:>13.4f} {after[name]:>15.5f} "
          f"{before[name] / after[name]:>8.1f}x")
con.execute("DROP INDEX idx_station_day")
con.execute("CREATE INDEX idx_cover ON readings (station, day, pm25)")
cover = {name: timeit(sql, 1) for name, sql in QUERIES.items()}
print("\nWith a covering index (station, day, pm25):")
for name in QUERIES:
    print(f"   {name:<36} {cover[name]:.5f} s")

