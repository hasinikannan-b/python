# Extractive summariser.
STOP = {
    "the", "a", "an", "is", "are", "was", "were", "i", "am", "to", "of",
    "in", "at", "and", "it", "for", "on", "our", "my", "we", "this", "that",
    "with", "by", "from", "as", "me", "you", "please", "very", "every", "has",
    "have", "can", "could", "he", "she", "so", "us", "your", "his"
}


def sentences_of(text):
    return [sentence.strip() for sentence in re.split(r"(?<=[.!?])\s+", text.strip())
            if sentence.strip()]


def important_words(sentence):
    return [word for word in re.findall(r"[a-z0-9']+", sentence.lower())
            if word not in STOP]


def summarise(text, k=2):
    sentences = sentences_of(text)
    frequencies = Counter(word for sentence in sentences
                          for word in important_words(sentence))
    scores = [sum(frequencies[word] for word in important_words(sentence))
              for sentence in sentences]
    best = sorted(range(len(sentences)), key=lambda index: -scores[index])[:k]
    return " ".join(sentences[index] for index in sorted(best))


def first_k(text, k=2):
    """Return the first k complete sentences without scanning the remaining text."""
    output = []
    position = 0
    sentence_pattern = re.compile(r"[^.!?]*[.!?]")
    for _ in range(k):
        match = sentence_pattern.match(text, position)
        if not match:
            break
        output.append(match.group().strip())
        position = match.end()
    return " ".join(output)


